{
  "name": "@morrowlist/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"linted from repository root\""
  },
  "dependencies": {
    "@morrowlist/contracts": "workspace:*",
    "@morrowlist/domain": "workspace:*",
    "@morrowlist/observability": "workspace:*"
  },
  "devDependencies": {
    "@morrowlist/config": "workspace:*",
    "ical.js": "2.2.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
