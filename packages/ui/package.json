{
  "name": "@morrowlist/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"linted from repository root\""
  },
  "dependencies": {
    "react": "19.1.1"
  },
  "devDependencies": {
    "@morrowlist/config": "workspace:*",
    "@types/react": "19.1.10",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
