{
  "name": "@morrowlist/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"linted from repository root\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@morrowlist/api": "workspace:*",
    "@morrowlist/api-client": "workspace:*",
    "@morrowlist/application": "workspace:*",
    "@morrowlist/auth": "workspace:*",
    "@morrowlist/config": "workspace:*",
    "@morrowlist/contracts": "workspace:*",
    "@morrowlist/database": "workspace:*",
    "@morrowlist/domain": "workspace:*",
    "@morrowlist/observability": "workspace:*",
    "@morrowlist/ui": "workspace:*",
    "@tanstack/react-query": "5.85.5",
    "better-auth": "1.3.7",
    "next": "15.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.1.12",
    "@tailwindcss/postcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "@playwright/test": "1.55.0"
  }
}
