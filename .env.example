# Application
# NODE_ENV is set by the tooling (next build sets production); do not pin it here.
APP_URL=http://localhost:3200
PORT=3200
E2E_PORT=3250
LOG_LEVEL=info

# Database
# Local development uses the Homebrew PostgreSQL 18 cluster (or the docker-compose
# service in infra/compose). No production-usable default is provided on purpose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/morrowlist
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/morrowlist_test
# Playwright drives this one and truncates it before every run; never point it at DATABASE_URL.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/morrowlist_e2e
DATABASE_POOL_MAX=10

# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3200
# Optional GitHub sign-in (AUTH-002). Omit both to disable the provider.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email adapter
EMAIL_PROVIDER=console
EMAIL_FROM=morrowlist@localhost

# Optional inbound email capture. Both must be set to enable; AUTH_SECRET is also required.
# Configure the receiving domain/MX and a trusted provider adapter first. Never put the
# delivery secret in a URL. See docs/runbooks/quick-capture.md.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

# Optional web push (GAP-13). All three set together, or push stays off and the
# notification settings page says so. Generate a pair once and keep it — rotating it
# invalidates every browser registration:
#   node scripts/generate-vapid.mjs mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Reminder worker (GAP-13): embedded in the web process, external (`pnpm worker`), or off.
WORKER_MODE=embedded
WORKER_POLL_SECONDS=30

# PWA and retention
TRASH_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_HOURS=24
OUTBOX_RETENTION_DAYS=90
