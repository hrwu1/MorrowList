# Copy to infra/compose/.env and edit. Everything below has a working default except the
# two secrets, which the compose file refuses to start without.
#
#   docker compose -f infra/compose/docker-compose.prod.yml --env-file infra/compose/.env up -d

# --- required ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- where the app is reached ----------------------------------------------
# The URL the browser uses. Behind a reverse proxy this is the public https:// URL, and
# AUTH_TRUSTED_ORIGINS must list the same origin or sign-in is rejected.
APP_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Host port to publish; the container always listens on 3000.
MORROWLIST_PORT=3000

# --- image ------------------------------------------------------------------
# Pin a release rather than tracking latest once you are running for real.
MORROWLIST_IMAGE=ghcr.io/morrowlist/morrowlist:latest

# --- database ---------------------------------------------------------------
POSTGRES_USER=morrowlist
POSTGRES_DB=morrowlist
DATABASE_POOL_MAX=10

# --- optional ---------------------------------------------------------------
LOG_LEVEL=info
# embedded runs the reminder loop inside the web process; external expects a separate
# container running the `worker` role; off disables reminders entirely.
WORKER_MODE=embedded
WORKER_POLL_SECONDS=30
EMAIL_PROVIDER=console
EMAIL_FROM=morrowlist@localhost
# Web push: set all three or none. Generate with `node scripts/generate-vapid.mjs`.
# Keep the pair — rotating it invalidates every browser registration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# GitHub sign-in: set both or neither.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TRASH_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=90
# Set to false when running more than one app container; see the runbook.
RUN_MIGRATIONS=true
