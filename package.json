{
  "name": "morrowlist",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "setup:dev": "node scripts/setup-dev.mjs",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @morrowlist/database db:generate",
    "db:migrate": "pnpm --filter @morrowlist/database db:migrate",
    "db:seed": "pnpm --filter @morrowlist/database db:seed",
    "openapi:generate": "pnpm --filter @morrowlist/api openapi:generate",
    "openapi:check": "pnpm --filter @morrowlist/api openapi:check",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e": "pnpm --filter @morrowlist/web test:e2e",
    "worker": "node scripts/worker.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@morrowlist/config": "workspace:*",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "eslint-plugin-import-x": "4.16.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
